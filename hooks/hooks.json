{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from inspeximus==3.12.0 python -m inspeximus.claude_code"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from inspeximus==3.12.0 python -m inspeximus.claude_code"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from inspeximus==3.12.0 python -m inspeximus.claude_code"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from inspeximus==3.12.0 python -m inspeximus.claude_code"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from inspeximus==3.12.0 python -m inspeximus.claude_code",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
