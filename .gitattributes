# The transparency log is HASHED, so its bytes must survive a checkout unchanged.
#
# Without this, git rewrites LF to CRLF in the working tree on Windows. The log's leaves are the
# file's bytes, so two extra characters per line change every leaf hash, change the Merkle root, and
# make `verify.py` report FAILED on an honest log for anyone who cloned on Windows. CI runs on Linux
# and would never see it, which is the worst shape a defect can have: invisible to us, visible to the
# reader we asked to check us.
#
# `-text` means "never translate". Not `binary`, which would also suppress diffs: an append-only log
# is exactly the thing whose diffs are worth reading.
transparency/claims.log   -text
transparency/log.jsonl    -text
transparency/payloads.json -text
transparency/head.json    -text
transparency/keys.json    -text
transparency/verify.py    -text

# Receipts are COSE, so they are binary in fact as well as in name.
transparency/entries/*.cose binary

# The anchor fixtures, for exactly the same reason, found again a month later in a different place.
# The receipts are stamped in Linux CI over LF bytes; the same head.json checked out on Windows has
# CRLF, so an untampered file reports MISMATCH and the first person to check concludes tampering.
# The rule above was written for `transparency/` and stopped there. Anything a signature, a receipt
# or a timestamp commits to belongs here, wherever it lives.
tests/fixtures/ots/head.json -text
tests/fixtures/ots/block968177.header.hex -text
tests/fixtures/ots/head.json.ots binary
tests/fixtures/ots/upgrade.alice.bin binary

# The golden store re-verified by tests/test_evidence_survivors_write_receipts.py. Its receipts commit to
# record fields, not bytes, but keep the files exactly as the release wrote them anyway.
tests/fixtures/golden_store_3.9.1/* -text
